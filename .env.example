# =====================================================================
# Cadence — Environment Configuration Template
# Copy this file to `.env.local` or `.env` and fill in your values.
# =====================================================================

# Database Configuration (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# AI Provider API Keys
# Gemini is the default fast multimodal provider for card generation.
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"

# Optional: Anthropic Fallback Provider
ANTHROPIC_API_KEY=""

# Development & Testing Flags
# Set to 'true' if you wish to run on offline mock fixtures without an AI key
USE_MOCKS=false
PORT=3000

# Rate limiting: set to 1 ONLY when deployed behind a reverse proxy that
# overwrites X-Forwarded-For. Otherwise the header is client-spoofable and ignored.
TRUSTED_PROXY=0
